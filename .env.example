# Git Activity Tracker Configuration
# Copy this file to .env and customize

# Comma-separated list of author identifiers (names and/or emails)
# Used to filter commits by author
GIT_ACTIVITY_AUTHORS=Your Name,your.email@example.com,alternate@email.com

# Max scan depth (optional)
# How deep to recurse when looking for git repositories
GIT_SCAN_DEPTH=3
